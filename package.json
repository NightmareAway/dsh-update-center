{
  "name": "dsh-update-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "自动检查插件与桌面客户端更新，并在侧边栏底部提供一键更新入口。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "icon": "icon.svg",
  "license": "MIT"
}
